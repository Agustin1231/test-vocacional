# Backend .NET — variables de entorno (plantilla)
# Copiar a .env y completar con valores reales. El .env NO se commitea.

# --- Base de datos MySQL ---
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=

# --- Autenticación JWT ---
JWT_ISSUER=
JWT_AUDIENCE=
JWT_SIGNING_KEY=
JWT_EXPIRES_MINUTES=

# --- Servicio de IA (REST interno) ---
IA_BASE_URL=

# --- App ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000