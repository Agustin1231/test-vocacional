# Backend .NET — variables de entorno (plantilla)
# Copiar a .env y completar con valores reales. El .env NO se commitea.

# --- Base de datos MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=test_vocacional
DB_USER=
DB_PASSWORD=

# --- Autenticación JWT ---
JWT_ISSUER=test-vocacional
JWT_AUDIENCE=test-vocacional
JWT_SIGNING_KEY=            # clave secreta para firmar tokens (larga y aleatoria)
JWT_EXPIRES_MINUTES=120

# --- Servicio de IA (REST interno) ---
# En docker-compose, el host es el nombre del servicio (ej. http://ia:8000).
IA_BASE_URL=http://localhost:8000

# --- App ---
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:5000
