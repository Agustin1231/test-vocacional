# Servicio de IA (Python) — variables de entorno (plantilla)
# Copiar a .env y completar con valores reales. El .env NO se commitea.

# Proveedor del LLM: "google" u "openrouter".
LLM_PROVIDER=google

# --- Opción A: Google Gemini directo (API key de Google AI Studio) ---
GOOGLE_API_KEY=              # clave de Google AI Studio (secreta, nunca al frontend)
GOOGLE_MODEL=gemini-flash-lite-latest

# --- Opción B: OpenRouter (compatible con OpenAI) ---
OPENROUTER_API_KEY=          # clave de OpenRouter (secreta, nunca al frontend)
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Vector store / RAG (plan de estudios) ---
# Base pgvector donde viven los PDF indexados y sus embeddings. Formato
# SQLAlchemy con el driver psycopg 3:
#   postgresql+psycopg://usuario:password@host:5432/base
# Si el password lleva @ / : o #, hay que percent-encodearlo (va dentro de la URL).
#
# VACÍA = RAG DESACTIVADO, y es una degradación deliberada, no una falla: el
# agente arranca igual y responde igual, solo que no se le ofrece la herramienta
# `buscar_plan_estudios`. Con infra/docker-compose.yml esta variable la inyecta el
# compose (el host es el nombre del servicio `ragdb`), así que acá se deja vacía.
VECTOR_STORE_URL=

# Modelo de embeddings. Cambiarlo sobre una base YA INDEXADA deja los vectores
# viejos incomparables con los nuevos: hay que borrar los documentos del panel y
# volverlos a subir.
RAG_EMBEDDING_MODEL=models/gemini-embedding-001

# Dimensiones del vector. 768 y no las 3072 que da el modelo por defecto porque
# los índices de pgvector (hnsw, ivfflat) no pasan de 2000 dimensiones: con 3072
# la búsqueda quedaría siempre secuencial. El servicio aborta ruidosamente si este
# número no coincide con el de la tabla ya creada.
RAG_EMBEDDING_DIMS=768

# Cuántos fragmentos devuelve la búsqueda, y el piso de similitud coseno (0 a 1)
# para considerarlos relevantes. Si nada llega al piso, la herramienta devuelve
# vacío y el agente dice que no tiene el dato, en lugar de responder con el
# fragmento menos malo.
RAG_TOP_K=5
RAG_MIN_SIMILITUD=0.45

# Tope de tamaño del PDF que se acepta subir, en MB.
RAG_MAX_PDF_MB=20

# Troceado del texto antes de embeber (caracteres por fragmento y solape).
RAG_CHUNK_CHARS=1200
RAG_CHUNK_OVERLAP=150

# --- Memoria de conversación ---
# Cuántos intercambios (pregunta + respuesta) del historial se le pasan al modelo
# en cada mensaje. Es una VENTANA: más allá de esto el agente se olvida del
# principio de la conversación, sin avisar.
#
# Se cuenta en intercambios, no en filas de la tabla, que son el doble. Subirlo
# encarece TODAS las respuestas de la conversación, porque el historial entero
# viaja al modelo en cada pregunta.
MEMORIA_INTERCAMBIOS=10

# --- Base de datos MySQL (memoria de conversación) ---
# El servicio crea la tabla `conversacion_memoria` solo al arrancar.
# En Coolify: DB_HOST = nombre interno del contenedor de la DB (misma red).
# Si queda vacío, el agente responde igual pero sin persistir memoria.
# OJO: estas credenciales tienen que ser las de MYSQL_USER / MYSQL_PASSWORD de
# infra/.env (las mismas que backend/.env). Si el usuario no coincide, la
# conexión falla y la memoria queda desactivada en silencio: el chat responde
# igual, pero olvida cada turno anterior.
DB_HOST=mysql
DB_PORT=3306
DB_NAME=test_vocacional
DB_USER=mysql
DB_PASSWORD=

# --- Seguridad ---
# Clave compartida que el backend envía en el header X-API-Key. Larga y aleatoria.
# Fail-closed: si está vacía, el servicio rechaza todas las peticiones.
SERVICE_API_KEY=
# Rate limit por estudiante (formato slowapi): p. ej. "20/minute", "5/second".
# La clave de partición es la cabecera X-Cliente-IP que agrega el backend con la
# IP real del navegador; si no viene, cae a la IP del cliente TCP (el backend), y
# ahí el límite pasa a ser global para todos los estudiantes.
RATE_LIMIT=20/minute

# --- App ---
# El puerto NO es configurable: uvicorn escucha en 8000 (ia/Dockerfile) y el
# healthcheck del compose apunta ahí. Solo se alcanza por la red interna.
LOG_LEVEL=info
