# Servicio de IA (Python) — variables de entorno (plantilla)
# Copiar a .env y completar con valores reales. El .env NO se commitea.

# Proveedor del LLM: "google" u "openrouter".
LLM_PROVIDER=google

# --- Opción A: Google Gemini directo (API key de Google AI Studio) ---
GOOGLE_API_KEY=              # clave de Google AI Studio (secreta, nunca al frontend)
GOOGLE_MODEL=gemini-flash-lite-latest

# --- Opción B: OpenRouter (compatible con OpenAI) ---
OPENROUTER_API_KEY=          # clave de OpenRouter (secreta, nunca al frontend)
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Vector store / RAG ---
# Para el volumen de una universidad, pgvector o Qdrant embebido alcanza.
VECTOR_STORE_URL=

# --- Base de datos MySQL (memoria de conversación) ---
# El servicio crea la tabla `conversacion_memoria` solo al arrancar.
# En Coolify: DB_HOST = nombre interno del contenedor de la DB (misma red).
# Si queda vacío, el agente responde igual pero sin persistir memoria.
DB_HOST=
DB_PORT=3306
DB_NAME=test_vocacional
DB_USER=mysql
DB_PASSWORD=

# --- Seguridad ---
# Clave compartida que el backend envía en el header X-API-Key. Larga y aleatoria.
# Fail-closed: si está vacía, el servicio rechaza todas las peticiones.
SERVICE_API_KEY=
# Rate limit por IP (formato slowapi): p. ej. "20/minute", "5/second".
RATE_LIMIT=20/minute

# --- App ---
APP_PORT=8000
LOG_LEVEL=info
